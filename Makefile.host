# =============================================================================
# CANbossTouch - Linux/SDL2-Host-Build der LVGL-Oberflaeche
#
# Laesst die komplette UI (EDS-Screens + PoC-Hallenlicht) am Entwicklungs-PC
# laufen (Vorbild: examples/oxivgl-host im embassy-Repo):
#   - Display/Maus ueber den LVGL-SDL-Treiber (host/lv_conf.h: LV_USE_SDL 1)
#   - SDO gemockt (host/canboss_sdo_host.c, simulierte Datenpunkte)
#   - PoC-CAN ueber SocketCAN (host/canboss_poc_can_host.c, Default vcan0)
#
# Voraussetzungen: gcc, pkg-config, libsdl2-dev; LVGL-Submodul ausgecheckt.
#
#   make host              (Kurzform, siehe Makefile)
#   make -f Makefile.host
#   ./build/host/canboss_host [can-interface]
# =============================================================================

TARGET = canboss_host
BUILD_DIR = build/host

CC ?= gcc
PKG_CONFIG ?= pkg-config

LVGL_DIR = Middlewares/Third_Party/LVGL/lvgl
LVGL_SOURCES = $(shell find $(LVGL_DIR)/src -name '*.c')

APP_SOURCES = \
App/canboss_ui.c \
App/canboss_poc.c \
$(wildcard App/generated/*.c)

HOST_SOURCES = $(wildcard host/*.c)

C_SOURCES = $(APP_SOURCES) $(HOST_SOURCES) $(LVGL_SOURCES)

# -Ihost vor dem LVGL-Verzeichnis: LV_CONF_INCLUDE_SIMPLE zieht host/lv_conf.h
C_INCLUDES = \
-Ihost \
-IMiddlewares/Third_Party/LVGL \
-IApp \
-IApp/generated

CFLAGS = -O2 -g -Wall $(C_INCLUDES) -DLV_CONF_INCLUDE_SIMPLE \
         $(shell $(PKG_CONFIG) --cflags sdl2) \
         -MMD -MP -MF"$(@:%.o=%.d)"
LDFLAGS = $(shell $(PKG_CONFIG) --libs sdl2) -lpthread -lm

OBJECTS = $(addprefix $(BUILD_DIR)/,$(C_SOURCES:.c=.o))

all: $(BUILD_DIR)/$(TARGET)

$(BUILD_DIR)/%.o: %.c Makefile.host
	@mkdir -p $(dir $@)
	$(CC) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET): $(OBJECTS) Makefile.host
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	@echo "Host-Build: $@"

clean:
	-rm -rf $(BUILD_DIR)

-include $(shell find $(BUILD_DIR) -name '*.d' 2>/dev/null)

.PHONY: all clean
