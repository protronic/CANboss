# Applikationsoptionen der CANbossTouch-Zephyr-App

mainmenu "CANbossTouch - CANopen-Touchpanel"

config CANBOSSTOUCH_NODE_ID
	int "Eigene CANopen-Node-ID des Panels"
	range 1 127
	default 127
	help
	  Node-ID, mit der das Panel selbst am Bus haengt
	  (canboss_master.eds -> App/OD, Node 127).

config CANBOSSTOUCH_BERRY
	bool "Berry-Scripting (od-Modul + Shell-Kommando)"
	default y
	help
	  Bindet die Berry-VM (Middlewares/Third_Party/berry) ein und
	  registriert das Shell-Kommando "berry". Skripte erreichen das
	  Objektverzeichnis ueber od.read/od.write (SDO zu entfernten
	  Knoten) und od.local/od.local_write (eigenes OD, inkl. der
	  per RPDO empfangenen PDO-Werte).

config CANBOSSTOUCH_DRAW_EVE
	bool "LVGL DRAW_EVE fuer FT813 (GPU-Displaylisten)"
	depends on LV_USE_DRAW_EVE && SPI && GPIO
	default n
	help
	  Rendert die UI ueber LVGL LV_USE_DRAW_EVE als EVE-Displaylisten
	  auf dem gen4-FT813 (kein MCU-Framebuffer). SPI/GPIO kommen aus
	  dem DT-Knoten protronic,ft813; Touch ueber lv_draw_eve_touch.
	  native_sim bleibt beim Zephyr-Display-Binding (SDL/Dummy).

source "Kconfig.zephyr"
