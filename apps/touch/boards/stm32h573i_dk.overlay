/*
 * STM32H573I-DK mit gen4-FT813-70CTP-CLB am Arduino-Header
 * (Verdrahtung siehe README im Repo-Root):
 *
 *   SCK  = D13 = PI1  (SPI2_SCK)     MISO = D12 = PI2  (SPI2_MISO)
 *   MOSI = D11 = PB15 (SPI2_MOSI)    /CS  = D10 = PA3  (GPIO)
 *   PD   = D9  = PA8  (GPIO)         INT  = D8  = PG8  (unbenutzt)
 *   CAN  : RX = D3 = PB5 (FDCAN2_RX)  TX = D15 = PB6 (FDCAN2_TX)
 *
 * zephyr,display zeigt auf ein Dummy-Display (Zephyr-LVGL-Modul braucht
 * ein Chosen); die echte UI laeuft ueber LVGL DRAW_EVE + SPI-Glue am
 * ft813-Knoten. Touch kommt vom Pointer-Indev des DRAW_EVE-Glue
 * (native FT813-Touch-Engine), nicht von zephyr,lvgl-pointer-input.
 */

/ {
	chosen {
		zephyr,display = &dummy_dc;
		zephyr,canbus = &fdcan2;
	};

	dummy_dc: dummy_dc {
		compatible = "zephyr,dummy-dc";
		width = <800>;
		height = <480>;
	};
};

&spi2 {
	status = "okay";
	/* /CS als GPIO: DRAW_EVE steuert CS manuell ueber mehrere
	 * SPI-Bursts hinweg (Zephyr-Auto-CS waere zu kurz). */
	pinctrl-0 = <&spi2_sck_pi1 &spi2_miso_pi2 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 3 GPIO_ACTIVE_LOW>;

	ft813: ft813@0 {
		compatible = "protronic,ft813";
		reg = <0>;
		/* Bring-up im Glue mit 8 MHz; Betrieb danach mit
		 * 250 MHz Kerneltakt / 16 = 15.625 MHz (FT81x-Max 30 MHz) */
		spi-max-frequency = <15625000>;
		pd-gpios = <&gpioa 8 GPIO_ACTIVE_LOW>; /* PD_N: low = Power-Down */
		width = <800>;
		height = <480>;
		backlight-duty = <96>;
		touch-poll-ms = <0>; /* Touch ueber lv_draw_eve_touch */
	};
};

/* CANopen ueber FDCAN2 am Arduino-Header (PB5/PB6); das Onboard-FDCAN1
 * des DK bleibt frei. */
&fdcan2 {
	status = "okay";
	pinctrl-0 = <&fdcan2_rx_pb5 &fdcan2_tx_pb6>;
	pinctrl-names = "default";
	bitrate = <500000>; /* wie der bisherige Firmware-Stand */
};
