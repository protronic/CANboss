menu "CANboss Gateway (NDJSON fuer Webapps)"

config CANBOSS_GW_NODE_ID
	int "Eigene CANopen-Node-ID"
	range 1 127
	default 126
	help
	  Default 126, damit das Gateway neben einem Monitor/Panel
	  (Node 127, canboss_master-Default) auf demselben Bus laufen kann.

config CANBOSS_GW_FW_SLOTS
	int "Firmware-Slots im RAM"
	range 1 4
	default 1

config CANBOSS_GW_FW_SLOT_SIZE
	int "Groesse je Firmware-Slot in Bytes"
	default 65536
	help
	  RAM-Backend (lib/host_io/ndjson_fw_ram.c) - nach Reset leer.
	  STM32H573 hat 640 KiB SRAM; native_sim ist unkritisch.

config CANBOSS_GW_BERRY
	bool "Berry-REPL im JSON-Interface ({\"repl\": ...})"
	default y
	help
	  Berry-VM mit den od_*-Bindings (lib/berry_od) einbauen; Webapps
	  koennen dann Berry-Code per {"repl": "od_read(16,0x1017,0)"}
	  ausfuehren. Kostet Flash/RAM und braucht Python (Berry-coc).

config CANBOSS_GW_CANOPEN
	bool "CANopen-Stack starten"
	default y
	help
	  Zum Eingrenzen von Problemen abschaltbar (z.B. USB-Bisect am
	  H573I-DK, overlays/nocanopen.conf): ohne CANopen laufen ping/
	  info/fw-Upload weiter, gtwa und SLCAN melden Fehler.

config CANBOSS_GW_USB
	bool "NDJSON ueber USB-CDC-ACM (statt ST-Link-VCP)"
	depends on USB_DEVICE_STACK_NEXT
	default y
	help
	  Auf Targets mit USB-Device-Controller (STM32H573I-DK: USB_DRD_FS
	  an PA11/PA12, Board-Label zephyr_udc0) laeuft der NDJSON-Strom
	  ueber eine CDC-ACM-Instanz am USB-Stecker des Boards. Der Browser
	  sieht sie als seriellen Port und erreicht sie per WebSerial - ohne
	  ST-Link, ohne Treiberinstallation.

	  Die Instanz und das chosen "canboss,jsonapi-uart" kommen aus
	  boards/stm32h573i_dk.overlay; zurueck auf die ST-Link-VCP geht es
	  mit overlays/stlink_vcp.overlay + overlays/stlink_vcp.conf.

if CANBOSS_GW_USB

config CANBOSS_GW_USB_VID
	hex "USB Vendor ID"
	default 0x0483
	help
	  STMicroelectronics (0x0483), damit WebSerial-Filter wie in LSM6
	  ({ usbVendorId: 0x0483 }) den User-USB-Port finden. Die
	  ST-LINK-VCP hat dieselbe VID (PID 0x374e) — im Picker den
	  Eintrag mit Produktstring "CANboss Gateway …" nehmen, nicht
	  den ST-LINK. lsusb ohne -v kommt aus usb.ids zum VID/PID-Paar.

config CANBOSS_GW_USB_PID
	hex "USB Product ID"
	default 0x5740
	help
	  STM32 Virtual COM Port (STs CDC-ACM-PID). Nicht 0x374e, das
	  ist die ST-LINK-VCP. usbdemo bleibt bei 1209:0001.

config CANBOSS_GW_USB_MANUFACTURER
	string "USB-Herstellerstring"
	default "Protronic GmbH"

config CANBOSS_GW_USB_PRODUCT
	string "USB-Produktstring"
	default "CANboss Gateway SLCAN"
	help
	  iProduct: WebSerial-Dialog, lsusb -v, udev ATTRS{product} und
	  /dev/serial/by-id/usb-Protronic_GmbH_CANboss_Gateway_SLCAN_*.
	  slcand sollte diesen by-id-Pfad nehmen, nicht /dev/ttyACM0
	  (das ist am H573I-DK die ST-LINK-VCP).

config CANBOSS_GW_USB_MAX_POWER
	int "bMaxPower in 2-mA-Schritten"
	range 0 250
	default 125
	help
	  125 = 250 mA. Das Gateway meldet sich bus-powered, damit die
	  Angabe unabhaengig davon stimmt, ob das DK ueber ST-Link oder
	  ueber den USB-FS-Stecker versorgt wird.

endif # CANBOSS_GW_USB

endmenu

source "Kconfig.zephyr"
